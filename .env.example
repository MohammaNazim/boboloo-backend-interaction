# ============================================================
# Boboloo Backend — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================


# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname


# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...


# ─────────────────────────────────────────────
# FIREBASE
# ─────────────────────────────────────────────
# Local dev only — leave blank on Cloud Run (uses ADC)
FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json


# ─────────────────────────────────────────────
# SECURITY KEYS
# ─────────────────────────────────────────────
FACTORY_SECRET_KEY=change-me-factory
INTERNAL_CRON_SECRET=change-me-cron
ADMIN_INTERNAL_SECRET=change-me-admin-internal


# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
# development | production
ENVIRONMENT=development


# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
# Set to true only after AWS is configured and
# the bobotv_videos migration has been applied.
ENABLE_BOBOTV=false


# ─────────────────────────────────────────────
# AWS / S3  (BoboTV — only required when ENABLE_BOBOTV=true)
# ─────────────────────────────────────────────
# Leave blank to use IAM role / instance profile instead of static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# The name of your private S3 bucket for BoboTV videos
AWS_S3_BUCKET_BOBOTV=boboloo-bobotv-videos

# How long (seconds) presigned streaming URLs are valid. Default: 900 (15 min)
BOBOTV_PRESIGNED_URL_EXPIRY=900

# Max upload size in MB. Default: 500
BOBOTV_MAX_UPLOAD_SIZE_MB=500
